{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "framework":{
      "type":"string",
      "enum": ["react","vue"]
    },
    "mode": {
      "type": "string",
      "enum": ["jsx-text-only", "jsx-only", "all","vue-template-only"]
    },
    "jsx-components": {
      "type": "object",
      "properties": {
        "include": { "type": "array" },
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "jsx-attributes": {
      "type": "object",
      "properties": {
        "include": { "type": "array" },
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "words": {
      "type": "object",
      "properties": {
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "callees": {
      "type": "object",
      "properties": {
        "include": { "type": "array" },
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "object-properties": {
      "type": "object",
      "properties": {
        "include": { "type": "array" },
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "class-properties": {
      "type": "object",
      "properties": {
        "include": { "type": "array" },
        "exclude": { "type": "array" }
      },
      "additionalProperties": false
    },
    "message": { "type": "string" },
    "should-validate-template": { "type": "boolean" }
  },
  "additionalProperties": false
}